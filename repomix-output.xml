//! Store instruction operands, then encode them when emitting an ELF.

use rvgen::{elf::ElfBuilder, riscv::IntReg, Instruction};

fn main() -> rvgen::Result<()> {
    let instructions = [
        Instruction::Addi {
            rd: IntReg::a0,
            rs1: IntReg::zero,
            imm: 6,
        },
        Instruction::Addi {
            rd: IntReg::a1,
            rs1: IntReg::zero,
            imm: 7,
        },
        Instruction::Mul {
            rd: IntReg::a2,
            rs1: IntReg::a0,
            rs2: IntReg::a1,
        },
    ];
    let mut bytes = Vec::new();
    for instruction in instructions {
        instruction.append_bytes(&mut bytes);
    }
    let elf = rvgen::runtime::executable(&bytes, true, 0x8000_0000)?;
    let output = std::env::args_os()
        .nth(1)
        .unwrap_or_else(|| "encoded.elf".into());
    ElfBuilder.save(&elf, output)
}
