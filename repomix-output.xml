//! Core and basic-block storage with policy sampling and bytecode emission.

use rand::{
    distributions::{Distribution, WeightedIndex},
    rngs::StdRng,
};

use crate::{Instruction, Result};

use super::{
    policy::action_distribution, BasicBlockGeneratorParams, CoreGeneratorParams, GenerationAction,
};

#[derive(Debug, Clone)]
pub struct BasicBlockGenerator {
    pub params: BasicBlockGeneratorParams,
    pub insts: Vec<Instruction>,
    /// Policy actions retained for inspection until workload generation is implemented.
    pub selected_actions: Vec<GenerationAction>,
}

impl BasicBlockGenerator {
    pub fn new(params: BasicBlockGeneratorParams) -> Self {
        Self {
            params,
            insts: Vec::new(),
            selected_actions: Vec::new(),
        }
    }

    pub fn generate(
        &mut self,
        prng: &mut StdRng,
        weights: &[(GenerationAction, f64)],
    ) -> Result<()> {
        let distribution = action_distribution(weights)?;
        self.sample(prng, weights, &distribution);
        Ok(())
    }

    fn sample(
        &mut self,
        prng: &mut StdRng,
        weights: &[(GenerationAction, f64)],
        distribution: &WeightedIndex<f64>,
    ) {
        self.selected_actions.clear();
        self.selected_actions
            .extend((0..self.params.num_insts).map(|_| weights[distribution.sample(prng)].0));
    }
}

#[derive(Debug, Clone)]
pub struct CoreGenerator {
    pub params: CoreGeneratorParams,
    pub bbs: Vec<BasicBlockGenerator>,
}

impl CoreGenerator {
    pub fn new(params: CoreGeneratorParams) -> Self {
        Self {
            params,
            bbs: (0..params.num_bbs)
                .map(|i| {
                    BasicBlockGenerator::new(BasicBlockGeneratorParams {
                        num_insts: params.num_insts,
                        label: format!("bb_{i}"),
                    })
                })
                .collect(),
        }
    }

    pub fn generate(
        &mut self,
        prng: &mut StdRng,
        weights: &[(GenerationAction, f64)],
    ) -> Result<()> {
        let distribution = action_distribution(weights)?;
        for bb in &mut self.bbs {
            bb.sample(prng, weights, &distribution);
        }
        Ok(())
    }

    pub fn get_bytecode(&self) -> Vec<u8> {
        let mut bytes = Vec::new();
        for instruction in self.bbs.iter().flat_map(|bb| &bb.insts) {
            instruction.append_bytes(&mut bytes);
        }
        bytes
    }

    pub fn get_section_addr(&self) -> u64 {
        0
    }
}
