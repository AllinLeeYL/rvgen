use object::{Object, ObjectSection};
use rvgen::{generator::GenerationAction, riscv::IntReg, Generator, GeneratorParams, Instruction};

#[test]
fn default_generator_has_empty_workload_and_renders_all_blocks() {
    let mut generator = Generator::new(GeneratorParams::default()).unwrap();
    generator.generate().unwrap();
    assert!(generator.cores[0].get_bytecode().is_empty());
    let assembly = generator.assembly().unwrap();
    assert!(!assembly.contains("{{"));
    for block in &generator.cores[0].bbs {
        assert_eq!(
            assembly
                .matches(&format!("\n{}:", block.params.label))
                .count(),
            1
        );
    }
    assert_eq!(generator.cores[0].bbs.len(), 12);
    assert!(generator.cores[0]
        .bbs
        .iter()
        .all(|bb| bb.selected_actions.len() == 256 && bb.insts.is_empty()));
}

#[test]
fn seed_reproduces_selection_and_zero_weights_are_never_selected() {
    let mut first = Generator::new(GeneratorParams {
        seed: 1729,
        ..Default::default()
    })
    .unwrap();
    let mut second = Generator::new(first.params.clone()).unwrap();
    first.generate().unwrap();
    second.generate().unwrap();
    let selections = |g: &Generator| {
        g.cores[0]
            .bbs
            .iter()
            .flat_map(|bb| bb.selected_actions.iter().copied())
            .collect::<Vec<_>>()
    };
    assert_eq!(selections(&first), selections(&second));
    for action in selections(&first) {
        assert!(first
            .action_weights
            .iter()
            .any(|(c, w)| *c == action && *w > 0.0));
    }
    first.generate().unwrap();
    assert_eq!(selections(&first), selections(&second));
    second.params.seed += 1;
    second.generate().unwrap();
    assert_ne!(selections(&first), selections(&second));
}

#[test]
fn weights_are_local_and_multicore_output_is_rejected() {
    let single = Generator::new(GeneratorParams::default()).unwrap();
    let mut multi = Generator::new(GeneratorParams {
        num_cores: 2,
        size: 21,
        num_bbs: 3,
        ..Default::default()
    })
    .unwrap();
    assert_eq!(
        single
            .action_weights
            .iter()
            .find(|(c, _)| *c == GenerationAction::SendIpi)
            .unwrap()
            .1,
        0.0
    );
    assert!(
        multi
            .action_weights
            .iter()
            .find(|(c, _)| *c == GenerationAction::SendIpi)
            .unwrap()
            .1
            > 0.0
    );
    multi.generate().unwrap();
    assert_eq!(multi.cores.len(), 2);
    assert!(multi.cores.iter().all(
        |core| core.bbs.len() == 3 && core.bbs.iter().all(|bb| bb.selected_actions.len() == 10)
    ));
    assert!(multi.elf().is_err());
}

#[test]
fn explicit_instructions_serialize_in_block_order() {
    let mut generator = Generator::new(GeneratorParams::default()).unwrap();
    generator.cores[0].bbs[0].insts.push(Instruction::Addi {
        rd: IntReg::ra,
        rs1: IntReg::zero,
        imm: 42,
    });
    generator.cores[0].bbs[1].insts.push(Instruction::CAddi {
        rd: IntReg::zero,
        imm: 0,
    });
    assert_eq!(generator.cores[0].get_bytecode(), [0x93, 0, 0xa0, 2, 1, 0]);
    assert!(generator.assembly().unwrap().contains(".4byte 0x02a00093"));
    assert!(generator.assembly().unwrap().contains(".2byte 0x0001"));
    let bytes = generator.elf().unwrap();
    let file = object::File::parse(bytes.as_slice()).unwrap();
    let text = file.section_by_name(".text").unwrap().data().unwrap();
    // The runtime installs mtvec with three instructions before the workload.
    assert_eq!(&text[12..18], &[0x93, 0, 0xa0, 2, 1, 0]);
}

#[test]
fn invalid_weights_return_errors_and_single_action_is_selected() {
    let mut generator = Generator::new(GeneratorParams::default()).unwrap();
    for weight in [0.0, -1.0, f64::NAN, f64::INFINITY] {
        generator.action_weights = vec![(GenerationAction::Alu, weight)];
        assert!(generator.generate().is_err());
    }
    generator.action_weights.clear();
    assert!(generator.generate().is_err());
    generator.action_weights = vec![(GenerationAction::Alu, 1.0)];
    generator.generate().unwrap();
    assert!(generator.cores[0]
        .bbs
        .iter()
        .flat_map(|bb| &bb.selected_actions)
        .all(|c| *c == GenerationAction::Alu));
}
