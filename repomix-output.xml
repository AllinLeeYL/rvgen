<file path="src/generator/policy.rs">
//! Weighted workload-generation policy, independent of instruction encoding.

use rand::distributions::WeightedIndex;

use crate::Result;

/// A choice made by the workload-generation policy.
///
/// Some actions select instruction families; others request state changes or
/// multi-instruction sequences. They are not ISA opcodes or classifications of
/// an existing `Instruction`. The current scaffold records choices only.
/// Variant discriminants are not a serialized format.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub enum GenerationAction {
    RegFsm,
    FpuFsm,
    Alu,
    Alu64,
    MulDiv,
    MulDiv64,
    Amo,
    Amo64,
    Jal,
    Jalr,
    Branch,
    Memory,
    Memory64,
    FloatMemory,
    Float,
    Float64,
    DoubleMemory,
    Double,
    Double64,
    Exception,
    RandomCsr,
    DescendPrivilege,
    Fence,
    WaitForInterruptTrap,
    WaitForInterruptNoTrap,
    SendIpi,
    SendLocalInterrupt,
    ClearInterrupt,
    EpcFsm,
    TvecFsm,
    MachineCsr,
    FreePolluted,
    CreateAddressDependency,
    ClearMdt,
    ResetMcm,
    WriteInstruction,
    WaitForInstruction,
}

/// Relative sampling weights in a stable order for seeded generation.
/// These are the active defaults; historical TOML tables are not loaded.
pub const DEFAULT_ACTION_WEIGHTS: &[(GenerationAction, f64)] = &[
    (GenerationAction::Alu, 0.1),
    (GenerationAction::Alu64, 0.1),
    (GenerationAction::MulDiv, 0.1),
    (GenerationAction::MulDiv64, 0.1),
    (GenerationAction::Jal, 0.01),
    (GenerationAction::Jalr, 0.01),
    (GenerationAction::Branch, 0.4),
    (GenerationAction::Memory, 0.5),
    (GenerationAction::Memory64, 0.5),
    (GenerationAction::Amo, 0.0),
    (GenerationAction::Amo64, 0.0),
    (GenerationAction::Fence, 1e-06),
    (GenerationAction::FloatMemory, 0.0),
    (GenerationAction::DoubleMemory, 0.0),
    (GenerationAction::FpuFsm, 0.0),
    (GenerationAction::Float, 0.0),
    (GenerationAction::Float64, 0.0),
    (GenerationAction::Double, 0.0),
    (GenerationAction::Double64, 0.0),
    (GenerationAction::RegFsm, 0.1),
    (GenerationAction::TvecFsm, 0.1),
    (GenerationAction::EpcFsm, 0.1),
    (GenerationAction::FreePolluted, 5.0),
    (GenerationAction::CreateAddressDependency, 2.0),
    (GenerationAction::MachineCsr, 0.1),
    (GenerationAction::Exception, 0.1),
    (GenerationAction::RandomCsr, 0.0),
    (GenerationAction::DescendPrivilege, 0.1),
    (GenerationAction::WaitForInterruptTrap, 0.7),
    (GenerationAction::WaitForInterruptNoTrap, 0.4),
    (GenerationAction::SendIpi, 5.0),
    (GenerationAction::SendLocalInterrupt, 0.0),
    (GenerationAction::ClearInterrupt, 0.4),
    (GenerationAction::WriteInstruction, 0.0),
    (GenerationAction::WaitForInstruction, 0.0),
    (GenerationAction::ClearMdt, 0.0),
    (GenerationAction::ResetMcm, 0.0),
];

pub(super) fn default_action_weights(num_cores: usize) -> Vec<(GenerationAction, f64)> {
    let mut action_weights = DEFAULT_ACTION_WEIGHTS.to_vec();
    if num_cores == 1 {
        for (action, weight) in &mut action_weights {
            if matches!(
                action,
                GenerationAction::SendIpi
                    | GenerationAction::ClearInterrupt
                    | GenerationAction::WaitForInterruptTrap
                    | GenerationAction::WaitForInterruptNoTrap
            ) {
                *weight = 0.0;
            }
        }
    }
    action_weights
}

pub(super) fn action_distribution(
    weights: &[(GenerationAction, f64)],
) -> Result<WeightedIndex<f64>> {
    let total: f64 = weights.iter().map(|(_, w)| w).sum();
    if weights.iter().any(|(_, w)| !w.is_finite() || *w < 0.0) || !total.is_finite() || total <= 0.0
    {
        return Err("action weights must be finite, nonnegative, and have a positive total".into());
    }
    Ok(WeightedIndex::new(weights.iter().map(|(_, w)| *w))?)
}
