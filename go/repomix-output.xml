	p.NumBBs = 2
	g := mustGenerator(t, p)
	g.ChoiceWeights = []ChoiceWeight{{ActionChoice(RegFsm), 1}}
	if err := g.Generate(); err != nil {
		t.Fatal(err)
	}
	for _, b := range g.Cores[0].Blocks {
		for _, s := range b.SelectedChoices {
			if s.End-s.Start != 2 {
				t.Fatal("truncated sequence")
