package rvgen

import (
	_ "embed"
	"fmt"
	"math/rand"
	"os"
	"rvgen/riscv"
	"strings"
)

// SelectedChoice records the half-open instruction range emitted by a choice.
// Callers editing Instructions must update or discard these generation records.
type SelectedChoice struct {
	Choice     GenerationChoice
	Start, End int
}
type BasicBlock struct {
	Params          BasicBlockParams
	Instructions    []riscv.Instruction
	SelectedChoices []SelectedChoice
}

func (b *BasicBlock) Generate(rng *rand.Rand, weights []ChoiceWeight, ctx GenerationContext) error {
	if b.Params.NumInsts < 0 {
		return fmt.Errorf("instruction budget must be nonnegative")
	}
	if _, err := weightTotal(weights); err != nil {
		return err
	}
	for _, w := range weights {
		if w.Weight > 0 {
			if err := w.Choice.Validate(ctx); err != nil {
				return err
			}
		}
	}
	insts := make([]riscv.Instruction, 0, b.Params.NumInsts)
	selected := make([]SelectedChoice, 0, b.Params.NumInsts)
	eligible := make([]ChoiceWeight, len(weights))
	for len(insts) < b.Params.NumInsts {
		copy(eligible, weights)
		for {
			total, err := weightTotal(eligible)
			if err != nil {
				return fmt.Errorf("cannot fill block %s: no choice fits remaining budget of %d", b.Params.Label, b.Params.NumInsts-len(insts))
			}
			target := rng.Float64() * total
			index := -1
			for j, w := range eligible {
				if w.Weight == 0 {
					continue
				}
				index = j
				if target < w.Weight {
					break
				}
				target -= w.Weight
			}
			choice := eligible[index].Choice
			var lowered [2]riscv.Instruction
			n := choice.lower(rng, ctx, &lowered)
			if n > b.Params.NumInsts-len(insts) {
				eligible[index].Weight = 0
				continue
			}
			start := len(insts)
			insts = append(insts, lowered[:n]...)
			selected = append(selected, SelectedChoice{choice, start, len(insts)})
			if n != 0 {
				break
			}
			for j, w := range eligible {
				if w.Choice == choice {
					eligible[j].Weight = 0
				}
			}
		}
	}
	b.Instructions = insts
	b.SelectedChoices = selected
	return nil
}

type Core struct {
	Params CoreParams
	Blocks []BasicBlock
}

func NewCore(p CoreParams) Core {
	c := Core{Params: p}
	for i := 0; i < p.NumBBs; i++ {
		c.Blocks = append(c.Blocks, BasicBlock{Params: BasicBlockParams{partition(p.NumInsts, p.NumBBs, i), fmt.Sprintf("bb_%d", i)}})
	}
	return c
}
func (c *Core) Generate(rng *rand.Rand, weights []ChoiceWeight, ctx GenerationContext) error {
	if c.Params.NumBBs <= 0 || c.Params.NumInsts < 0 {
		return fmt.Errorf("invalid core budget or block count")
	}
	next := NewCore(c.Params)
	for i := range next.Blocks {
		if err := next.Blocks[i].Generate(rng, weights, ctx); err != nil {
			return err
		}
	}
	c.Blocks = next.Blocks
	return nil
}
func (c Core) Bytecode() []byte {
	count := 0
	for _, b := range c.Blocks {
		count += len(b.Instructions)
	}
	bytes := make([]byte, 0, count*4)
	for _, b := range c.Blocks {
		for _, inst := range b.Instructions {
			bytes = inst.AppendBytes(bytes)
		}
	}
	return bytes
}

type Generator struct {
	Params        GeneratorParams
	Cores         []Core
	ChoiceWeights []ChoiceWeight
}

func NewGenerator(p GeneratorParams) (*Generator, error) {
	if err := p.Validate(); err != nil {
		return nil, err
	}
	return &Generator{p, createCores(p), DefaultChoiceWeights(p.Is64Bit, p.AuthorizePrivileges)}, nil
}
func createCores(p GeneratorParams) []Core {
	cores := make([]Core, p.NumCores)
	for i := range cores {
		cores[i] = NewCore(CoreParams{p.NumBBs, partition(p.Size, p.NumCores, i)})
	}
	return cores
}

// Generate replaces the entire workload only after successful generation.
// The Go RNG is reproducible, but its stream differs from Rust's ChaCha RNG.
func (g *Generator) Generate() error {
	if err := g.Params.Validate(); err != nil {
		return err
	}
	seed := g.Params.Seed
	if seed < 0 {
		seed = -seed
	}
	rng := rand.New(rand.NewSource(seed))
	ctx := GenerationContext{g.Params.Is64Bit, g.Params.AuthorizePrivileges}
	cores := createCores(g.Params)
	for i := range cores {
		if err := cores[i].Generate(rng, g.ChoiceWeights, ctx); err != nil {
			return err
		}
	}
	g.Cores = cores
	return nil
}

//go:embed templates/riscv64.S
var assemblyTemplate string

func (g *Generator) Assembly() (string, error) {
	if len(g.Cores) == 0 {
		return "", fmt.Errorf("no cores to render")
	}
	var blocks strings.Builder
	for _, b := range g.Cores[0].Blocks {
		fmt.Fprintf(&blocks, "\n%s:\n    ", b.Params.Label)
		for _, i := range b.Instructions {
			fmt.Fprintf(&blocks, "\n    %s\n    ", i)
		}
		blocks.WriteByte('\n')
	}
	return strings.ReplaceAll(assemblyTemplate, "{{ basic_blocks }}", blocks.String()), nil
}
func (g *Generator) GenAssembly(path string) error {
	s, err := g.Assembly()
	if err != nil {
		return err
	}
	return os.WriteFile(path, []byte(s), 0644)
}
func (g *Generator) ELF() ([]byte, error) {
	if len(g.Cores) != 1 {
		return nil, fmt.Errorf("only one core is supported for ELF output")
	}
	return Executable(g.Cores[0].Bytecode(), g.Params.Is64Bit, g.Params.StartAddr)
}
func (g *Generator) GenELF(path string) error {
	data, err := g.ELF()
	if err != nil {
		return err
	}
	return os.WriteFile(path, data, 0644)
}
