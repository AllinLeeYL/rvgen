	if len(insts) != 2 || insts[0].Kind != riscv.Addi || insts[1].Kind != riscv.Lw || insts[0].Rd != insts[1].Rs1 || insts[0].Rd == insts[0].Rs1 {
		t.Fatal("address dependency sequence")
	}
}
