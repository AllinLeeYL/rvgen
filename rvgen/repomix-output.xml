pub fn instruc_citype(opcode: i32, rds1: i32, funct3: i32, imm: i32) -> u32 {
    assert!(opcode < 4);
    assert!(rds1 < 32);
    assert!(funct3 < 1 << 3);
    let imm4_0_offset = 2;
    let rds1_offset = imm4_0_offset + 5;
    let imm5_offset = rds1_offset + 5;
    let funct3_offset = imm5_offset + 1;
    let imm4_0 = imm & 31;
    let imm5 = imm >> 5 & 1;
